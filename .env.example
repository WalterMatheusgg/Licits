# Exemplo de conexao publica Supabase para o React.
# Restaure o .env local com: bash scripts/restaurar-acesso.sh
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_publishable_key_here
# Legado aceito como alternativa: VITE_SUPABASE_ANON_KEY=your_legacy_anon_key_here
VITE_ENVIRONMENT=development

# Secrets e senhas de banco NAO devem ser adicionados com prefixo VITE_.
# OPENAI_API_KEY, RESEND_API_KEY, SUPABASE_SERVICE_ROLE_KEY e ALERT_DISPATCH_SECRET
# pertencem ao gerenciador de segredos do Supabase Edge.
