{
  "name": "PriceRegistrationGroup",
  "type": "object",
  "properties": {
    "price_registration_id": {
      "type": "string",
      "description": "ID do Registro de Pre\u00e7os (preg\u00e3o)"
    },
    "arp_number": {
      "type": "string",
      "description": "N\u00ba da ARP/Contrato"
    },
    "group_number": {
      "type": "string",
      "description": "N\u00ba do Grupo"
    },
    "supplier_name": {
      "type": "string",
      "description": "Nome da empresa"
    },
    "supplier_cnpj": {
      "type": "string",
      "description": "CNPJ"
    },
    "supplier_address": {
      "type": "string",
      "description": "Endere\u00e7o"
    },
    "supplier_city": {
      "type": "string",
      "description": "Cidade"
    },
    "supplier_state": {
      "type": "string",
      "description": "Estado"
    },
    "supplier_cep": {
      "type": "string",
      "description": "CEP"
    },
    "supplier_phone": {
      "type": "string",
      "description": "Telefone"
    },
    "supplier_email": {
      "type": "string",
      "description": "E-mail"
    },
    "supplier_contact": {
      "type": "string",
      "description": "Respons\u00e1vel"
    },
    "start_date": {
      "type": "string",
      "format": "date",
      "description": "Data de in\u00edcio"
    },
    "end_date": {
      "type": "string",
      "format": "date",
      "description": "Data de vig\u00eancia"
    },
    "total_value": {
      "type": "number",
      "description": "Valor total do grupo"
    },
    "can_extend": {
      "type": "boolean",
      "default": false,
      "description": "Pode prorrogar (+12 meses)"
    },
    "status": {
      "type": "string",
      "enum": [
        "ativo",
        "vencido",
        "encerrado",
        "suspenso"
      ],
      "default": "ativo",
      "description": "Status do grupo/ARP"
    },
    "notes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es"
    }
  },
  "required": [
    "price_registration_id",
    "arp_number",
    "supplier_name"
  ]
}