{
  "name": "FiscalRecord",
  "type": "object",
  "properties": {
    "contract_id": {
      "type": "string",
      "description": "ID do contrato"
    },
    "record_type": {
      "type": "string",
      "enum": [
        "semanal",
        "mensal",
        "anual",
        "por_escopo",
        "vistoria",
        "relatorio",
        "medicao"
      ],
      "description": "Tipo de fiscaliza\u00e7\u00e3o"
    },
    "title": {
      "type": "string",
      "description": "T\u00edtulo da rotina"
    },
    "description": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o / observa\u00e7\u00f5es"
    },
    "file_url": {
      "type": "string",
      "description": "Documento anexo"
    },
    "file_name": {
      "type": "string",
      "description": "Nome do arquivo"
    },
    "comments": {
      "type": "string",
      "description": "Coment\u00e1rios adicionais"
    },
    "status": {
      "type": "string",
      "enum": [
        "pendente",
        "concluido",
        "em_andamento"
      ],
      "default": "pendente",
      "description": "Status"
    },
    "signed_by": {
      "type": "string",
      "description": "Assinado por (e-mail)"
    },
    "signed_by_name": {
      "type": "string",
      "description": "Nome do respons\u00e1vel"
    },
    "signed_at": {
      "type": "string",
      "description": "Data/hora da assinatura"
    },
    "fiscal_date": {
      "type": "string",
      "format": "date",
      "description": "Data da fiscaliza\u00e7\u00e3o"
    }
  },
  "required": [
    "contract_id",
    "record_type",
    "description"
  ]
}