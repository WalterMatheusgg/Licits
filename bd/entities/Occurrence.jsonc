{
  "name": "Occurrence",
  "type": "object",
  "properties": {
    "contract_id": {
      "type": "string",
      "description": "ID do contrato"
    },
    "contract_number": {
      "type": "string",
      "description": "N\u00famero do contrato"
    },
    "supplier_name": {
      "type": "string",
      "description": "Nome da empresa"
    },
    "supplier_cnpj": {
      "type": "string",
      "description": "CNPJ da empresa"
    },
    "title": {
      "type": "string",
      "description": "T\u00edtulo da ocorr\u00eancia"
    },
    "content": {
      "type": "string",
      "description": "Texto da ocorr\u00eancia"
    },
    "occurrence_date": {
      "type": "string",
      "format": "date",
      "description": "Data da ocorr\u00eancia"
    },
    "registered_by": {
      "type": "string",
      "description": "E-mail do registrante"
    },
    "registered_by_name": {
      "type": "string",
      "description": "Nome do registrante"
    },
    "signature_name": {
      "type": "string",
      "description": "Nome na assinatura"
    },
    "file_url": {
      "type": "string",
      "description": "Arquivo alicits"
    },
    "file_name": {
      "type": "string",
      "description": "Nome do arquivo"
    },
    "status": {
      "type": "string",
      "enum": [
        "aberta",
        "em_analise",
        "resolvida",
        "arquivada"
      ],
      "default": "aberta",
      "description": "Status da ocorr\u00eancia"
    },
    "severity": {
      "type": "string",
      "enum": [
        "baixa",
        "media",
        "alta",
        "critica"
      ],
      "default": "media",
      "description": "Severidade"
    }
  },
  "required": [
    "contract_id",
    "title",
    "content"
  ]
}