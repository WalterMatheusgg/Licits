{
  "name": "ContractItem",
  "type": "object",
  "properties": {
    "contract_id": {
      "type": "string",
      "description": "ID do contrato"
    },
    "group_number": {
      "type": "string",
      "description": "N\u00ba do Grupo"
    },
    "item_number": {
      "type": "string",
      "description": "N\u00ba do Item"
    },
    "description": {
      "type": "string",
      "description": "Especifica\u00e7\u00e3o do item"
    },
    "unit": {
      "type": "string",
      "description": "Unidade de medida"
    },
    "contracted_qty": {
      "type": "number",
      "description": "Quantidade total contratada"
    },
    "min_qty": {
      "type": "number",
      "description": "Quantidade m\u00ednima"
    },
    "used_qty": {
      "type": "number",
      "default": 0,
      "description": "Quantidade utilizada"
    },
    "unit_price": {
      "type": "number",
      "description": "Valor unit\u00e1rio (R$)"
    }
  },
  "required": [
    "contract_id",
    "description"
  ]
}