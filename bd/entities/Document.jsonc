{
  "name": "Document",
  "type": "object",
  "properties": {
    "contract_id": {
      "type": "string",
      "description": "ID do contrato vinculado"
    },
    "title": {
      "type": "string",
      "description": "T\u00edtulo do documento"
    },
    "doc_type": {
      "type": "string",
      "enum": [
        "contrato",
        "aditivo",
        "holerite",
        "gfip",
        "fgts",
        "inss",
        "certidao",
        "relatorio",
        "notificacao",
        "oficio",
        "parecer",
        "termo",
        "outro"
      ],
      "description": "Tipo do documento"
    },
    "file_url": {
      "type": "string",
      "description": "URL do arquivo"
    },
    "status": {
      "type": "string",
      "enum": [
        "pendente",
        "assinado",
        "aprovado",
        "rejeitado"
      ],
      "default": "pendente",
      "description": "Status do documento"
    },
    "signed_by": {
      "type": "string",
      "description": "Assinado por"
    },
    "signed_at": {
      "type": "string",
      "description": "Data/hora da assinatura"
    },
    "version": {
      "type": "number",
      "default": 1,
      "description": "Vers\u00e3o do documento"
    },
    "notes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es"
    }
  },
  "required": [
    "title",
    "doc_type"
  ]
}