{
  "name": "PriceRegistration",
  "type": "object",
  "properties": {
    "auction_number": {
      "type": "string",
      "description": "N\u00ba do Preg\u00e3o Eletr\u00f4nico"
    },
    "sei_number": {
      "type": "string",
      "description": "N\u00ba do Processo SEI"
    },
    "object": {
      "type": "string",
      "description": "Objeto do preg\u00e3o"
    },
    "registration_type": {
      "type": "string",
      "enum": [
        "srp_cfp",
        "adesao"
      ],
      "default": "srp_cfp",
      "description": "SRP do CFP ou Ades\u00e3o de outro \u00f3rg\u00e3o"
    },
    "adhesion_organ": {
      "type": "string",
      "description": "Nome do \u00f3rg\u00e3o (quando ades\u00e3o)"
    },
    "adhesion_auction_number": {
      "type": "string",
      "description": "N\u00ba do Preg\u00e3o do \u00f3rg\u00e3o (quando ades\u00e3o)"
    },
    "status": {
      "type": "string",
      "enum": [
        "ativo",
        "encerrado",
        "suspenso",
        "em_analise"
      ],
      "default": "em_analise",
      "description": "Status"
    },
    "notes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es"
    }
  },
  "required": [
    "auction_number",
    "object"
  ]
}