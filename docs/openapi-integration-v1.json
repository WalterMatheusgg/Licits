{
  "openapi": "3.1.0",
  "info": {
    "title": "Licits Integration API",
    "version": "1.0.0",
    "description": "API de contratos isolada por organização. Aceita JWT Supabase ou credencial máquina-a-máquina lct_."
  },
  "servers": [
    { "url": "https://nefimqoszcidsnqvlnnh.supabase.co/functions/v1" }
  ],
  "paths": {
    "/integration-contracts": {
      "post": {
        "operationId": "integrateContracts",
          "summary": "Consultar, criar ou atualizar contratos e credenciais",
        "security": [{ "bearerAuth": [], "apiKey": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/IntegrationRequest" }
            }
          }
        },
        "responses": {
          "200": { "description": "Consulta ou atualização concluída" },
          "201": { "description": "Contrato criado" },
          "400": { "description": "Requisição inválida ou usuário não autenticado" },
          "401": { "description": "Credencial inválida ou expirada" },
          "403": { "description": "Papel sem permissão para a operação" },
          "404": { "description": "Contrato não encontrado na organização" },
          "409": { "description": "Número de contrato duplicado" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": { "type": "http", "scheme": "bearer", "bearerFormat": "JWT" },
      "apiKey": { "type": "apiKey", "in": "header", "name": "apikey" }
    },
    "schemas": {
      "IntegrationRequest": {
        "oneOf": [
          { "$ref": "#/components/schemas/ListContractsRequest" },
          { "$ref": "#/components/schemas/CreateContractRequest" },
          { "$ref": "#/components/schemas/UpdateContractRequest" },
          { "$ref": "#/components/schemas/CreateCredentialRequest" },
          { "$ref": "#/components/schemas/RevokeCredentialRequest" }
        ]
      },
      "ListContractsRequest": {
        "type": "object",
        "required": ["organization_id"],
        "properties": {
          "operation": { "const": "list", "default": "list" },
          "organization_id": { "type": "string", "format": "uuid" },
          "status": { "type": "string", "enum": ["ativo", "vencido", "encerrado", "suspenso", "cancelado", "em_analise", "em_analise_slic"] },
          "supplier_id": { "type": "string", "format": "uuid" },
          "contract_number": { "type": "string", "maxLength": 100 },
          "end_date_from": { "type": "string", "format": "date" },
          "end_date_to": { "type": "string", "format": "date" },
          "updated_since": { "type": "string", "format": "date-time" },
          "page": { "type": "integer", "minimum": 1, "default": 1 },
          "per_page": { "type": "integer", "minimum": 1, "maximum": 100, "default": 25 }
        }
      },
      "CreateContractRequest": {
        "type": "object",
        "required": ["operation", "organization_id", "contract"],
        "properties": {
          "operation": { "const": "create" },
          "organization_id": { "type": "string", "format": "uuid" },
          "contract": {
            "type": "object",
            "required": ["contract_number", "object", "supplier_name", "total_value"],
            "properties": {
              "contract_number": { "type": "string", "maxLength": 100 },
              "object": { "type": "string", "maxLength": 10000 },
              "supplier_name": { "type": "string", "maxLength": 250 },
              "supplier_cnpj": { "type": "string", "pattern": "^[0-9]{14}$" },
              "total_value": { "type": "number", "minimum": 0 }
            }
          }
        }
      },
      "UpdateContractRequest": {
        "type": "object",
        "required": ["operation", "organization_id", "contract_id", "updates"],
        "properties": {
          "operation": { "const": "update" },
          "organization_id": { "type": "string", "format": "uuid" },
          "contract_id": { "type": "string", "format": "uuid" },
          "updates": {
            "type": "object",
            "minProperties": 1,
            "properties": {
              "contract_number": { "type": "string", "maxLength": 100 },
              "sei_number": { "type": ["string", "null"] },
              "auction_number": { "type": ["string", "null"] },
              "object": { "type": "string", "maxLength": 10000 },
              "status": { "type": "string", "enum": ["ativo", "vencido", "encerrado", "suspenso", "cancelado", "em_analise", "em_analise_slic"] },
              "start_date": { "type": ["string", "null"], "format": "date" },
              "end_date": { "type": ["string", "null"], "format": "date" },
              "total_value": { "type": "number", "minimum": 0 },
              "modality": { "type": ["string", "null"] },
              "contract_type": { "type": ["string", "null"] },
              "responsible_sector": { "type": ["string", "null"] },
              "can_extend": { "type": "string", "enum": ["sim", "nao", "analise_pendente"] },
              "extensions_done": { "type": "integer", "minimum": 0 },
              "max_extensions": { "type": "integer", "minimum": 0 },
              "fiscal_status": { "type": "string", "enum": ["adequada", "regular", "baixa"] },
              "notes": { "type": ["string", "null"] }
            },
            "additionalProperties": false
          }
        }
      },
      "CreateCredentialRequest": {
        "type": "object",
        "required": ["operation", "organization_id", "name"],
        "properties": {
          "operation": { "const": "create_credential" },
          "organization_id": { "type": "string", "format": "uuid" },
          "name": { "type": "string", "maxLength": 100 },
          "scopes": { "type": "array", "uniqueItems": true, "items": { "type": "string", "enum": ["contracts:read", "contracts:write"] }, "default": ["contracts:read"] },
          "expires_at": { "type": "string", "format": "date-time" }
        }
      },
      "RevokeCredentialRequest": {
        "type": "object",
        "required": ["operation", "organization_id", "credential_id"],
        "properties": {
          "operation": { "const": "revoke_credential" },
          "organization_id": { "type": "string", "format": "uuid" },
          "credential_id": { "type": "string", "format": "uuid" }
        }
      }
    }
  }
}